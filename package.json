{
  "name": "fieldsense-ai",
  "version": "1.0.0",
  "description": "Multimodal Evidence Intelligence & Investigation Assistant for Field Technicians",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "start": "node server/src/server.js"
  },
  "keywords": [
    "multimodal",
    "gemini",
    "evidence-reasoning",
    "field-technician",
    "contradiction-detection",
    "mern"
  ],
  "author": "FieldSense AI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

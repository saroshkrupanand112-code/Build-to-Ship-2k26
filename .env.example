PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
HF_API_KEY=your_huggingface_api_key_here
JWT_SECRET=your_strong_jwt_secret_change_this
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Firebase / Firestore Configuration
# Option 1: Path to your service account JSON file (local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Full JSON string of service account (production / Render / Railway / Vercel)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Legacy — no longer required for normal operation
# MONGODB_URI=mongodb://localhost:27017/fieldsense_ai
